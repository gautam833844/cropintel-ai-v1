{
    "version": 2,
    "buildCommand": "python train_model.py",
    "env": {
        "PYTHONUNBUFFERED": "1"
    },
    "builds": [
        {
            "src": "api/index.py",
            "use": "@vercel/python"
        }
    ],
    "routes": [
        {
            "src": "/static/(.*)",
            "dest": "/static/$1"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.py"
        }
    ]
}