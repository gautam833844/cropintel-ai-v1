{
    "version": 2,
    "buildCommand": "python src/models/train_model.py && echo 'Build complete'",
    "builds": [
        {
            "src": "src/api/index.py",
            "use": "@vercel/python",
            "config": {
                "maxLambdaSize": "50mb",
                "runtime": "python3.9"
            }
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "/src/api/index.py"
        }
    ]
}